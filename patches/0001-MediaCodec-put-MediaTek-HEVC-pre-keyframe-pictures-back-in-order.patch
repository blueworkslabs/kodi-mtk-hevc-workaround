+CDVDVideoCodec::VCReturn CDVDVideoCodecAndroidMediaCodec::HandOverReorderPicture(
+    VideoPicture* pVideoPicture)
+{
+  // no new output buffer was dequeued, so the caller's previous buffer is still ours to release
+  if (pVideoPicture->videoBuffer)
+    pVideoPicture->videoBuffer->Release();
+  pVideoPicture->videoBuffer = nullptr;
+
+  pVideoPicture->SetParams(m_reorderPicture);
+  pVideoPicture->videoBuffer = m_reorderPicture.videoBuffer;
+  m_reorderPicture.videoBuffer = nullptr;
+  m_reorderPictureReady = false;
+
+  CLog::Log(LOGDEBUG, LOGVIDEO, "CDVDVideoCodecAndroidMediaCodec::GetPicture index: {}, pts:{:0.4f}",
+            static_cast<CMediaCodecVideoBuffer*>(pVideoPicture->videoBuffer)->GetBufferId(),
+            pVideoPicture->pts);
+  return VC_PICTURE;
+}
+
+void CDVDVideoCodecAndroidMediaCodec::HandOverPicture(VideoPicture* pVideoPicture,
+                                                      VideoPicture& picture,
+                                                      int64_t ptsUs)
+{
+  // pVideoPicture->videoBuffer holds no reference here
+  pVideoPicture->videoBuffer = nullptr;
+  pVideoPicture->SetParams(picture);
+  if (m_outputReorder && picture.pts != DVD_NOPTS_VALUE)
+    pVideoPicture->pts = ptsUs + m_dtsShift;
+  pVideoPicture->videoBuffer = picture.videoBuffer;
+  picture.videoBuffer = nullptr;
+
+  CLog::Log(LOGDEBUG, LOGVIDEO, "CDVDVideoCodecAndroidMediaCodec::GetPicture index: {}, pts:{:0.4f}",
+            static_cast<CMediaCodecVideoBuffer*>(pVideoPicture->videoBuffer)->GetBufferId(),
+            pVideoPicture->pts);
+}
+
+bool CDVDVideoCodecAndroidMediaCodec::ApplyReorder(const CMediaCodecOutputReorder::Result& result,
+                                                   VideoPicture* pVideoPicture,
+                                                   bool dequeued)
+{
+  using Source = CMediaCodecOutputReorder::Source;
+  LogReorder(result);
+  return CMediaCodecOutputReorder::Apply(
+      result, m_outputPtsUs,
+      [&](Source source, int64_t ptsUs)
+      {
+        // without a new output buffer the caller's previous buffer is still ours to release;
+        // GetOutputPicture() released it otherwise
+        if (!dequeued && pVideoPicture->videoBuffer)
+          pVideoPicture->videoBuffer->Release();
+        HandOverPicture(pVideoPicture, source == Source::CURRENT ? m_videobuffer : m_reorderPicture,
+                        ptsUs);
+      },
+      [&](Source source, int64_t ptsUs, bool ready)
+      {
+        KeepReorderPicture(source == Source::CURRENT ? m_videobuffer : m_reorderPicture, ptsUs);
+        m_reorderPictureReady = ready;
+      });
+}
+
+void CDVDVideoCodecAndroidMediaCodec::KeepReorderPicture(VideoPicture& picture, int64_t ptsUs)
+{
+  if (&picture != &m_reorderPicture)
+  {
+    if (m_reorderPicture.videoBuffer)
+      CLog::Log(LOGERROR, "CDVDVideoCodecAndroidMediaCodec::{}: slot busy, dropping its picture",
+                __func__);
+    m_reorderPicture.SetParams(picture); // releases a leftover buffer
+    m_reorderPicture.videoBuffer = picture.videoBuffer;
+    picture.videoBuffer = nullptr;
+  }
+  if (m_reorderPicture.pts != DVD_NOPTS_VALUE)
+    m_reorderPicture.pts = ptsUs + m_dtsShift;
+  m_reorderPictureReady = true;
+}
+
+void CDVDVideoCodecAndroidMediaCodec::DiscardReorderPicture()
+{
+  // back to MediaCodec without rendering
+  if (m_reorderPicture.videoBuffer)
+    m_reorderPicture.videoBuffer->Release();
+  m_reorderPicture.videoBuffer = nullptr;
+  m_reorderPictureReady = false;
+
+  if (m_outputReorder)
+    m_outputReorder->Reset();
+}
+
+void CDVDVideoCodecAndroidMediaCodec::LogReorder(const CMediaCodecOutputReorder::Result& result)
+{
+  using Event = CMediaCodecOutputReorder::Event;
+  switch (result.event)
+  {
+    case Event::HOLD:
+      CLog::Log(LOGDEBUG,
+                "CDVDVideoCodecAndroidMediaCodec: holding pts:{:0.4f} until earlier pictures arrive",
+                m_outputReorder->GetHeldPts() + m_dtsShift);
+      break;
+    case Event::RESTORED:
+      CLog::Log(LOGDEBUG, "CDVDVideoCodecAndroidMediaCodec: late picture pts:{:0.4f} -> {:0.4f}",
+                m_outputPtsUs + m_dtsShift, result.emit[0].pts + m_dtsShift);
+      break;
+    case Event::COMPLETE:
+      CLog::Log(LOGINFO,
+                "CDVDVideoCodecAndroidMediaCodec: put late pictures back before pts:{:0.4f}",
+                result.emit[result.count - 1].pts + m_dtsShift);
+      break;
+    case Event::GAVE_UP:
+    case Event::EXPIRED:
+      CLog::Log(LOGINFO,
+                "CDVDVideoCodecAndroidMediaCodec: handing over held pts:{:0.4f} unchanged ({})",
+                m_outputReorder->GetHeldPts() + m_dtsShift,
+                result.event == Event::EXPIRED ? "waited too long" : "pattern not complete");
+      break;
+    case Event::NONE:
+      break;
+  }
+}
