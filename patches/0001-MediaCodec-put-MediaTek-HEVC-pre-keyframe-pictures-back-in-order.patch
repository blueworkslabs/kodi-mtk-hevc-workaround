+#include "MediaCodecOutputReorder.h"
+
+#include <algorithm>
+
+bool CMediaCodecOutputReorder::Reset()
+{
+  const bool wasHolding = m_holding;
+  m_ledger.clear();
+  m_disabled = false;
+  m_hasLastOut = false;
+  m_lastOut = 0;
+  m_holding = false;
+  m_heldPts = 0;
+  m_heldSinceMs = 0;
+  m_lastLabel = 0;
+  m_missing.clear();
+  return wasHolding;
+}
+
+void CMediaCodecOutputReorder::AddInput(int64_t pts)
+{
+  if (m_disabled)
+    return;
+
+  // the same pts twice makes the ledger ambiguous
+  if (std::find(m_ledger.begin(), m_ledger.end(), pts) != m_ledger.end())
+  {
+    Disable();
+    return;
+  }
+
+  m_ledger.push_back(pts);
+  if (m_ledger.size() > MAX_LEDGER)
+    m_ledger.pop_front();
+}
+
+void CMediaCodecOutputReorder::Disable()
+{
+  m_disabled = true;
+  m_ledger.clear();
+}
+
+CMediaCodecOutputReorder::Result CMediaCodecOutputReorder::AddOutput(int64_t pts, int64_t nowMs)
+{
+  Result result;
+  const bool known = !m_disabled && TakeInput(pts);
+
+  if (m_holding)
+  {
+    if (!m_disabled)
+    {
+      if (!known && IsInventedLabel(pts))
+      {
+        // a late picture with an invented pts: it is the earliest picture still missing
+        m_lastLabel = pts;
+        const int64_t restored = m_missing.front();
+        m_missing.pop_front();
+        TakeInput(restored);
+        result.Add(Source::CURRENT, restored);
+        result.event = Event::RESTORED;
+        Handed(restored);
+        if (m_missing.empty())
+          ReleaseHeld(result, Event::COMPLETE);
+        return result;
+      }
+
+      const auto missing = std::find(m_missing.begin(), m_missing.end(), pts);
+      if (known && missing != m_missing.end())
+      {
+        // a late picture that kept its own pts
+        m_missing.erase(missing);
+        result.Add(Source::CURRENT, pts);
+        result.event = Event::RESTORED;
+        Handed(pts);
+        if (m_missing.empty())
+          ReleaseHeld(result, Event::COMPLETE);
+        return result;
+      }
+    }
+
+    // not the pattern: hand over what we have in the order the decoder gave it
+    ReleaseHeld(result, Event::GAVE_UP);
+    result.Add(Source::CURRENT, pts);
+    Handed(pts);
+    return result;
+  }
+
+  if (known && m_hasLastOut)
+  {
+    // queued pictures that belong between the last picture and this one but have not come out:
+    // a decoder outputs in presentation order, so they can only be late
+    std::deque<int64_t> missing;
+    for (const int64_t queued : m_ledger)
+    {
+      if (queued > m_lastOut && queued < pts)
+        missing.push_back(queued);
+    }
+
+    if (!missing.empty() && missing.size() <= MAX_MISSING && pts - m_lastOut <= MAX_GAP_US)
+    {
+      std::sort(missing.begin(), missing.end());
+      m_missing = std::move(missing);
+      m_holding = true;
+      m_heldPts = pts;
+      m_lastLabel = pts;
+      m_heldSinceMs = nowMs;
+      result.holdCurrent = true;
+      result.event = Event::HOLD;
+      return result;
+    }
+  }
+
+  result.Add(Source::CURRENT, pts);
+  Handed(pts);
+  return result;
+}
+
+CMediaCodecOutputReorder::Result CMediaCodecOutputReorder::DropOutput(int64_t pts)
+{
+  Result result;
+  const bool known = !m_disabled && TakeInput(pts);
+
+  if (m_holding)
+  {
+    const auto missing = std::find(m_missing.begin(), m_missing.end(), pts);
+    if (!m_disabled && !known && IsInventedLabel(pts))
+    {
+      // a late picture with an invented pts, dropped: its missing pts is gone
+      m_lastLabel = pts;
+      const int64_t lost = m_missing.front();
+      m_missing.pop_front();
+      TakeInput(lost);
+      Handed(lost);
+    }
+    else if (known && missing != m_missing.end())
+    {
+      m_missing.erase(missing);
+      Handed(pts);
+    }
+    else
+    {
+      ReleaseHeld(result, Event::GAVE_UP);
+      Handed(pts);
+      return result;
+    }
+
+    if (m_missing.empty())
+      ReleaseHeld(result, Event::COMPLETE);
+    return result;
+  }
+
+  Handed(pts);
+  return result;
+}
+
+CMediaCodecOutputReorder::Result CMediaCodecOutputReorder::AddUnlabelledOutput()
+{
+  Result result = Abandon();
+  result.Add(Source::CURRENT, 0);
+  return result;
+}
+
+CMediaCodecOutputReorder::Result CMediaCodecOutputReorder::Abandon()
+{
+  Result result;
+  if (m_holding)
+    ReleaseHeld(result, Event::GAVE_UP);
+  Disable();
+  return result;
+}
+
+CMediaCodecOutputReorder::Result CMediaCodecOutputReorder::Expire(int64_t nowMs)
+{
+  Result result;
+  if (m_holding && nowMs - m_heldSinceMs > MAX_HOLD_MS)
+    ReleaseHeld(result, Event::EXPIRED);
+  return result;
+}
+
+CMediaCodecOutputReorder::Result CMediaCodecOutputReorder::Flush()
+{
+  Result result;
+  if (m_holding)
+    ReleaseHeld(result, Event::GAVE_UP);
+  return result;
+}
+
+bool CMediaCodecOutputReorder::IsInventedLabel(int64_t pts) const
+{
+  // the decoder labels each late picture with its previous label + ~16 ms, below the next real
+  // picture after the held one; anything else is not a late picture
+  const int64_t step = pts - m_lastLabel;
+  if (m_missing.empty() || step < MIN_STEP_US || step > MAX_STEP_US)
+    return false;
+
+  return std::none_of(m_ledger.begin(), m_ledger.end(), [this, pts](int64_t queued) {
+    return queued > m_heldPts && queued <= pts;
+  });
+}
+
+bool CMediaCodecOutputReorder::TakeInput(int64_t pts)
+{
+  // some decoders report a queued pts a microsecond off
+  const auto it = std::find_if(m_ledger.begin(), m_ledger.end(), [pts](int64_t queued) {
+    return queued >= pts - PTS_TOLERANCE_US && queued <= pts + PTS_TOLERANCE_US;
+  });
+  if (it == m_ledger.end())
+    return false;
+
+  m_ledger.erase(it);
+  return true;
+}
+
+void CMediaCodecOutputReorder::ReleaseHeld(Result& result, Event event)
+{
+  result.Add(Source::HELD, m_heldPts);
+  result.event = event;
+
+  // whatever is still missing will not be shown in order any more
+  for (const int64_t pts : m_missing)
+    TakeInput(pts);
+  m_missing.clear();
+  m_holding = false;
+  Handed(m_heldPts);
+}
+
+void CMediaCodecOutputReorder::Handed(int64_t pts)
+{
+  if (!m_hasLastOut || pts > m_lastOut)
+    m_lastOut = pts;
+  m_hasLastOut = true;
+
+  // pts at or before the last handed-out picture can no longer be put in order
+  m_ledger.erase(std::remove_if(m_ledger.begin(), m_ledger.end(),
+                                [this](int64_t queued) { return queued <= m_lastOut; }),
+                 m_ledger.end());
+}
