+ */
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <deque>
+
+/*!
+ * \brief Puts back in order the pictures some MediaTek HEVC decoders emit out of order before a
+ * keyframe.
+ *
+ * Seen with OMX.MTK.VIDEO.DECODER.HEVC on a Fire TV Stick 4K Max (2nd gen): now and then the last
+ * pictures before a keyframe leave the decoder out of order. The picture with the highest pts comes
+ * first and keeps its own pts. The earlier pictures follow, but with invented, increasing pts
+ * (previous + ~16 ms) instead of their own. Their real pts never come back.
+ *
+ * The class keeps a ledger of the pts queued to the decoder. A decoder outputs in presentation
+ * order, so when a picture arrives shortly after the last handed-out one while queued pictures that
+ * belong between them are still missing, those are late: it holds that picture. A following picture
+ * is taken as late only if it carries the invented label: never queued, 12-20 ms above the previous
+ * label, and below the next real picture. Late pictures get the missing pts in ascending order,
+ * which assumes the decoder emits them in that order (as in every captured case); then the held
+ * picture follows them. Only one early picture ahead of up to MAX_MISSING late ones can be put
+ * right. When the next picture does not fit, the held picture is handed over first, then that
+ * picture unchanged, i.e. in the decoder's order. A picture without pts, a drain or a pts-less input
+ * stops all reordering until the next Reset(). A held picture is never kept longer than
+ * MAX_HOLD_MS.
+ *
+ * All pts are in the decoder's microsecond timebase (MediaCodec presentationTimeUs).
+ */
+class CMediaCodecOutputReorder
+{
+public:
+  enum class Source
+  {
+    CURRENT, //!< the picture just taken from the decoder
+    HELD, //!< the picture held back earlier
+  };
+
+  struct Emit
+  {
+    Source source;
+    int64_t pts;
+  };
+
+  enum class Event
+  {
+    NONE,
+    HOLD, //!< the current picture is held back
+    RESTORED, //!< a late picture got its missing pts back
+    COMPLETE, //!< all missing pictures arrived, the held picture follows them
+    GAVE_UP, //!< the pattern did not continue, the held picture is handed over as is
+    EXPIRED, //!< the held picture waited too long
+  };
+
+  struct Result
+  {
+    Emit emit[2]; //!< hand over in this order
+    int count = 0;
+    bool holdCurrent = false; //!< keep the current picture, it is the held one now
+    Event event = Event::NONE;
+
+    void Add(Source source, int64_t pts) { emit[count++] = {source, pts}; }
+  };
+
+  //! Most pictures the decoder may still owe before the held one.
+  static constexpr size_t MAX_MISSING = 3;
+  //! Longest a picture is held, in milliseconds.
+  static constexpr int64_t MAX_HOLD_MS = 250;
+  //! Most queued pts remembered.
+  static constexpr size_t MAX_LEDGER = 64;
+  //! A reported pts this close to a queued one is that picture (decoder rounding).
+  static constexpr int64_t PTS_TOLERANCE_US = 2;
+  //! Invented labels step this much above the previous label (seen: 16 ms). Anything closer may be
+  //! the same picture again, anything further another picture.
+  static constexpr int64_t MIN_STEP_US = 12000;
+  static constexpr int64_t MAX_STEP_US = 20000;
+  //! Largest distance from the last handed-out picture to a picture worth holding (seen: 125 ms).
+  static constexpr int64_t MAX_GAP_US = 200000;
+
+  /*!
+   * \brief Forget everything, e.g. after a flush.
+   * \return true if a picture was held; the caller must discard it without showing it.
+   */
+  bool Reset();
+
+  //! A picture with this pts was queued to the decoder.
+  void AddInput(int64_t pts);
+
+  //! A picture was queued without pts. The pattern cannot be told apart then, pass everything on.
+  void Disable();
+
+  /*!
+   * \brief A picture came out of the decoder.
+   * \param pts the pts the decoder reported
+   * \param nowMs a monotonic clock in milliseconds
+   */
+  Result AddOutput(int64_t pts, int64_t nowMs);
+
+  //! A picture came out of the decoder and was dropped without being shown.
+  Result DropOutput(int64_t pts);
+
+  /*!
+   * \brief A picture without pts came out of the decoder. It cannot be placed: the held picture goes
+   * first, then this one, and nothing more is reordered until Reset().
+   */
+  Result AddUnlabelledOutput();
+
+  /*!
+   * \brief Hand over the held picture and pass everything on unchanged until Reset(), e.g. before
+   * the decoder is drained or after a picture without pts was dropped.
+   */
+  Result Abandon();
+
+  //! Hand over the held picture if it has waited too long.
+  Result Expire(int64_t nowMs);
+
+  //! No more pictures will come (end of stream): hand over the held picture.
+  Result Flush();
+
+  /*!
+   * \brief Carry out a result: hand over its first picture now, keep the other one.
+   * \param currentPts pts of the current picture, used when it is held
+   * \param handOver handOver(source, pts) hands that picture over now
+   * \param keep keep(source, pts, ready) puts that picture in the codec's single slot; ready means
+   *             it is handed over on the next call, otherwise it is the held picture
+   * \return true if a picture was handed over
+   */
+  template<typename HandOver, typename Keep>
+  static bool Apply(const Result& result, int64_t currentPts, HandOver&& handOver, Keep&& keep)
+  {
+    if (result.holdCurrent)
+    {
+      keep(Source::CURRENT, currentPts, false);
+      return false;
+    }
+    if (result.count == 0)
+      return false;
+    handOver(result.emit[0].source, result.emit[0].pts);
+    if (result.count > 1)
+      keep(result.emit[1].source, result.emit[1].pts, true);
+    return true;
+  }
+
+  bool IsHolding() const { return m_holding; }
+  int64_t GetHeldPts() const { return m_heldPts; }
+
+private:
+  bool IsInventedLabel(int64_t pts) const;
+  bool TakeInput(int64_t pts);
+  void ReleaseHeld(Result& result, Event event);
+  void Handed(int64_t pts);
+
+  std::deque<int64_t> m_ledger; // queued pts not seen at the output yet, in queue order
+  bool m_disabled = false;
+
+  bool m_hasLastOut = false;
+  int64_t m_lastOut = 0;
+
+  bool m_holding = false;
+  int64_t m_heldPts = 0;
+  int64_t m_heldSinceMs = 0;
+  int64_t m_lastLabel = 0; // decoder label of the held picture, then of the last late picture
+  std::deque<int64_t> m_missing; // ascending
+};
